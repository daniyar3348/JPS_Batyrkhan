# Copy to .env for local development. Every setting is listed in app/core/config.py.
JPS_ENVIRONMENT=development
JPS_DATABASE_URL=postgresql+asyncpg://jps:jps@localhost:5432/jps
JPS_JOURNAL_SLUG=journal
JPS_WORKSPACE_URL=http://localhost:5173
JPS_COOKIE_SECURE=false
JPS_LOG_JSON=false
# console prints e-mails to the log; use smtp (and the JPS_SMTP_* settings) to really send them.
JPS_EMAIL_BACKEND=console
JPS_EMAIL_FROM=Demo Journal <no-reply@localhost>
# Signs the local storage links. Production needs 32 or more random characters.
JPS_SECRET_KEY=development-only-secret-change-me
# local keeps files under JPS_STORAGE_LOCAL_PATH; s3 uses any S3-compatible service (required in production).
JPS_STORAGE_BACKEND=local
JPS_STORAGE_LOCAL_PATH=var/storage
# JPS_S3_ENDPOINT_URL=https://s3.example.kz
# JPS_S3_REGION=us-east-1
# JPS_S3_BUCKET=jps-files
# JPS_S3_ACCESS_KEY_ID=
# JPS_S3_SECRET_ACCESS_KEY=
# disabled, or fake (made-up scores for development). Real providers are added later.
JPS_SIMILARITY_PROVIDER=fake
# Payments. The test provider shows a pretend card payment page (development only).
JPS_PAYMENTS_TEST_PROVIDER=true
# PayPal REST API (sandbox or live); the webhook id is shown in the PayPal developer dashboard.
# JPS_PAYPAL_MODE=sandbox
# JPS_PAYPAL_CLIENT_ID=
# JPS_PAYPAL_CLIENT_SECRET=
# JPS_PAYPAL_WEBHOOK_ID=
