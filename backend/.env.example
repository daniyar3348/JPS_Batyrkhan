# Copy to .env for local development. Every setting is listed in app/core/config.py.
JPS_ENVIRONMENT=development
JPS_DATABASE_URL=postgresql+asyncpg://jps:jps@localhost:5432/jps
JPS_JOURNAL_SLUG=journal
JPS_WORKSPACE_URL=http://localhost:5173
JPS_COOKIE_SECURE=false
JPS_LOG_JSON=false
# console prints e-mails to the log; use smtp (and the JPS_SMTP_* settings) to really send them.
JPS_EMAIL_BACKEND=console
JPS_EMAIL_FROM=Demo Journal <no-reply@localhost>
