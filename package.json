{
  "name": "jps",
  "private": true,
  "workspaces": [
    "packages/*",
    "workspace",
    "site"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "generate:api": "npm run generate --workspace @jps/api-client",
    "dev": "npm run dev --workspace @jps/workspace",
    "build": "npm run build --workspace @jps/workspace",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:site": "npm run dev --workspace @jps/site",
    "build:site": "npm run build --workspace @jps/site"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  }
}
